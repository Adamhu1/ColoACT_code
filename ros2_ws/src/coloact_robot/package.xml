<?xml version="1.0"?>
<package format="3">
  <name>coloact_robot</name>
  <version>0.1.0</version>
  <description>ColoACT ROS 2 deployment and robot-control nodes</description>
  <maintainer email="replace-before-publishing@example.com">ColoACT contributors</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>joy</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyserial</exec_depend>
  <exec_depend>python3-torch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>


